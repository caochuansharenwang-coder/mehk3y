page {
  --bg: #f7f7f7;
  --surface: #ffffff;
  --surface-2: #fafafa;
  --text: #0a0a0a;
  --text-2: #4a4a4a;
  --dim: #888;
  --faint: #bbb;
  --border: #ececec;
  --border-2: #e0e0e0;
  --accent: #0a0a0a;
  --accent-fg: #ffffff;
  --op: #b45309;  --op-bg: #fef3e6;
  --gt: #047857;  --gt-bg: #e6f7ef;
  --pt: #92722a;  --pt-bg: #fef9e6;
  --qg: #1e6fc9;  --qg-bg: #e6f0fb;
  --qo: #7c3aed;  --qo-bg: #f1eafe;
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}
