.wrap {
  padding: 24rpx 28rpx 80rpx;
}

/* Intro */
.intro { padding: 16rpx 0 24rpx; }
.title {
  font-size: 64rpx; font-weight: 800;
  letter-spacing: -2rpx; line-height: 1.05;
  margin-bottom: 16rpx;
}
.title-em { color: var(--text-2); }
.meta {
  font-size: 22rpx; color: var(--dim);
  margin-bottom: 18rpx;
}
.meta .dot { margin: 0 10rpx; opacity: 0.35; }
.desc {
  font-size: 26rpx; color: var(--dim); line-height: 1.7;
}
.desc .strong { color: var(--text); font-weight: 600; }

/* Sticky panel */
.panel {
  position: sticky; top: 0; z-index: 10;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(20rpx);
  padding: 16rpx 0;
  margin: 0 -28rpx 16rpx;
  padding-left: 28rpx; padding-right: 28rpx;
  border-bottom: 1rpx solid var(--border);
}
.search {
  position: relative;
  display: flex; align-items: center;
  background: var(--surface); border: 1rpx solid var(--border);
  border-radius: 16rpx; height: 72rpx; padding: 0 60rpx;
}
.search-icon {
  position: absolute; left: 18rpx; top: 50%;
  transform: translateY(-50%);
  font-size: 24rpx; color: var(--dim);
}
.search-input {
  flex: 1; height: 100%;
  font-size: 26rpx; color: var(--text);
}
.search-clear {
  position: absolute; right: 16rpx; top: 50%;
  transform: translateY(-50%);
  width: 36rpx; height: 36rpx;
  line-height: 32rpx; text-align: center;
  font-size: 32rpx; color: var(--dim);
}

.pills {
  display: flex; flex-wrap: nowrap;
  white-space: nowrap;
  margin-top: 16rpx;
}
.pill {
  display: inline-flex; align-items: center;
  font-size: 24rpx; font-weight: 500;
  padding: 10rpx 22rpx; border-radius: 999rpx;
  background: var(--surface-2); color: var(--text-2);
  border: 1rpx solid transparent;
  margin-right: 10rpx;
  flex-shrink: 0;
}
.pill.active {
  background: var(--accent); color: var(--accent-fg);
  border-color: var(--accent);
}
.pill-count {
  margin-left: 8rpx; opacity: 0.64;
  font-variant-numeric: tabular-nums;
}

/* Sections */
.section { margin-top: 36rpx; }
.section:first-child { margin-top: 8rpx; }
.section-header {
  display: flex; align-items: baseline;
  padding-bottom: 12rpx; margin-bottom: 16rpx;
  border-bottom: 1rpx solid var(--border);
}
.section-title {
  font-size: 22rpx; font-weight: 600;
  letter-spacing: 2rpx; text-transform: uppercase;
  color: var(--dim);
}
.section-count {
  margin-left: auto; font-size: 22rpx;
  color: var(--faint); font-variant-numeric: tabular-nums;
}

/* Cards */
.card {
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 16rpx;
}
.card-head {
  display: flex; justify-content: space-between;
  align-items: flex-start; gap: 16rpx;
  margin-bottom: 16rpx;
}
.word-line {
  display: flex; align-items: baseline;
  flex-wrap: wrap; gap: 10rpx;
  flex: 1; min-width: 0;
}
.word {
  font-size: 46rpx; font-weight: 800;
  letter-spacing: -1.5rpx; line-height: 1.1;
  color: var(--text);
}
.ipa {
  font-size: 24rpx; color: var(--dim);
  font-family: serif;
}
.card-head-r {
  display: flex; align-items: center; gap: 10rpx;
  flex-shrink: 0; margin-top: 6rpx;
}
.speak {
  width: 52rpx; height: 52rpx;
  line-height: 52rpx; text-align: center;
  font-size: 28rpx;
  background: var(--surface-2); border-radius: 50%;
  color: var(--dim);
}
.speak.playing { background: var(--accent); color: var(--accent-fg); }
.tag {
  font-size: 20rpx; font-weight: 600;
  padding: 4rpx 12rpx; border-radius: 8rpx;
  white-space: nowrap;
}
.tag-op { background: var(--op-bg); color: var(--op); }
.tag-gt { background: var(--gt-bg); color: var(--gt); }
.tag-pt { background: var(--pt-bg); color: var(--pt); }
.tag-qg { background: var(--qg-bg); color: var(--qg); }
.tag-qo { background: var(--qo-bg); color: var(--qo); }

.def-zh { font-size: 30rpx; font-weight: 600; margin-bottom: 6rpx; }
.def-en { font-size: 24rpx; color: var(--dim); line-height: 1.5; margin-bottom: 18rpx; }

/* Example */
.example {
  background: var(--bg); border: 1rpx solid var(--border);
  border-radius: 16rpx; padding: 18rpx 22rpx;
  margin-bottom: 16rpx;
}
.example-en { font-size: 28rpx; color: var(--text); line-height: 1.45; }
.example-zh { font-size: 26rpx; color: var(--text-2); margin-top: 4rpx; line-height: 1.45; }

/* Synonyms */
.syns {
  display: flex; flex-wrap: wrap; gap: 10rpx;
}
.syn {
  position: relative;
  font-size: 22rpx; color: var(--text-2);
  background: var(--bg); border: 1rpx solid var(--border);
  padding: 8rpx 16rpx 8rpx 32rpx; border-radius: 12rpx;
  transition: all 0.15s ease;
}
.syn::before {
  content: '♪';
  position: absolute; left: 14rpx; top: 50%;
  transform: translateY(-50%);
  font-size: 22rpx; opacity: 0.45;
}
.syn-hover {
  background: var(--accent); color: var(--accent-fg);
  border-color: var(--accent);
  transform: scale(0.96);
}
.syn-hover::before { opacity: 1; }

/* Synonym modal */
.modal-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.45); z-index: 100;
  display: flex; align-items: flex-end;
}
.modal-sheet {
  background: var(--surface); border-radius: 32rpx 32rpx 0 0;
  width: 100%; padding: 36rpx 36rpx 60rpx;
  box-sizing: border-box;
}
.modal-header {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 28rpx;
}
.modal-title { flex: 1; }
.modal-syn-word { font-size: 44rpx; font-weight: 800; color: var(--text); }
.modal-vs { font-size: 22rpx; color: var(--dim); margin: 0 8rpx; }
.modal-main-word { font-size: 26rpx; color: var(--dim); font-weight: 500; }
.modal-speak {
  width: 60rpx; height: 60rpx; line-height: 60rpx; text-align: center;
  font-size: 30rpx; background: var(--surface-2); border-radius: 50%;
  flex-shrink: 0;
}
.modal-row {
  display: flex; align-items: flex-start; gap: 16rpx;
  margin-bottom: 20rpx;
}
.modal-label {
  font-size: 22rpx; font-weight: 600; color: #c0392b;
  background: #fef0ee; padding: 4rpx 12rpx; border-radius: 8rpx;
  white-space: nowrap; flex-shrink: 0; margin-top: 2rpx;
}
.modal-val { font-size: 28rpx; color: var(--text); line-height: 1.5; flex: 1; }
.modal-val-dim { color: var(--dim); font-size: 26rpx; }
.modal-example { flex: 1; }
.modal-ex-en { font-size: 28rpx; color: var(--text); line-height: 1.5; }
.modal-ex-zh { font-size: 24rpx; color: var(--dim); margin-top: 4rpx; }
.modal-not-found {
  font-size: 26rpx; color: var(--dim); text-align: center;
  padding: 30rpx 0;
}
.modal-close {
  margin-top: 24rpx; text-align: center;
  font-size: 28rpx; color: var(--dim); padding: 16rpx;
}

/* Empty + footer */
.empty {
  text-align: center; padding: 120rpx 40rpx;
  color: var(--dim); font-size: 26rpx;
}
.footer {
  text-align: center; padding: 60rpx 0 20rpx;
  font-size: 22rpx; color: var(--faint);
}
