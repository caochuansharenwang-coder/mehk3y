<view class="wrap">

  <!-- Intro -->
  <view class="intro">
    <view class="title">Basic <text class="title-em">English</text></view>
    <view class="meta">
      <text>850 个核心词</text>
      <text class="dot">·</text>
      <text>Ogden Basic English</text>
      <text class="dot">·</text>
      <text>C.K. Ogden · 1930</text>
    </view>
    <view class="desc">
      850个英语核心常用词，没有繁琐的骨架。<text class="strong">英语不是靠死背海量单词，而是靠少量高频词的组合能力。</text>
    </view>
  </view>

  <!-- Sticky panel -->
  <view class="panel">
    <view class="search">
      <view class="search-icon">🔍</view>
      <input
        class="search-input"
        placeholder="搜索单词、释义或例句..."
        value="{{query}}"
        bindinput="onQueryInput"
        confirm-type="search"
      />
      <view wx:if="{{query}}" class="search-clear" bindtap="clearQuery">×</view>
    </view>
    <scroll-view scroll-x class="pills" enhanced show-scrollbar="{{false}}">
      <view
        wx:for="{{categories}}"
        wx:key="cat"
        class="pill {{activeCat === item.cat ? 'active' : ''}}"
        data-cat="{{item.cat}}"
        bindtap="onPillTap"
      >
        {{item.label}} <text class="pill-count">{{item.count}}</text>
      </view>
    </scroll-view>
  </view>

  <!-- Sections -->
  <block wx:for="{{sections}}" wx:key="cat" wx:for-item="sec">
    <view wx:if="{{sec.words.length > 0}}" class="section">
      <view class="section-header">
        <view class="section-title">{{sec.label}}</view>
        <view class="section-count">{{sec.words.length}} 个</view>
      </view>

      <view class="card" wx:for="{{sec.words}}" wx:for-item="w" wx:key="w" data-cat="{{w.c}}">
        <view class="card-head">
          <view class="word-line">
            <text class="word">{{w.w}}</text>
            <text wx:if="{{w.ipa}}" class="ipa">{{w.ipa}}</text>
          </view>
          <view class="card-head-r">
            <view class="speak" data-text="{{w.w}}" catchtap="onSpeakTap">🔊</view>
            <view class="tag tag-{{w.c}}">{{w.tagLabel}}</view>
          </view>
        </view>

        <view class="def-zh">{{w.zh}}</view>
        <view class="def-en">{{w.en}}</view>

        <view class="example">
          <view class="example-en">{{w.ex}}</view>
          <view class="example-zh">{{w.exz}}</view>
        </view>

        <view wx:if="{{w.s && w.s.length}}" class="syns">
          <view
            wx:for="{{w.s}}"
            wx:for-item="syn"
            wx:key="*this"
            class="syn"
            hover-class="syn-hover"
            hover-stay-time="120"
            data-syn="{{syn}}"
            data-main="{{w.w}}"
            catchtap="onSynTap"
          >{{syn}}</view>
        </view>
      </view>
    </view>
  </block>

  <view wx:if="{{empty}}" class="empty">没找到匹配的词。换个词试试?</view>

  <view class="footer">Mehk3y.com · Ogden Basic English · 850 词</view>
</view>

<!-- Synonym detail modal -->
<view wx:if="{{synModal}}" class="modal-mask" catchtap="closeSynModal">
  <view class="modal-sheet" catchtap="stopPropagation">
    <view class="modal-header">
      <view class="modal-title">
        <text class="modal-syn-word">{{synModal.syn}}</text>
        <text class="modal-vs"> vs </text>
        <text class="modal-main-word">{{synModal.main}}</text>
      </view>
      <view class="modal-speak" data-text="{{synModal.syn}}" catchtap="onSpeakTap">🔊</view>
    </view>
    <view wx:if="{{synModal.found}}">
      <view class="modal-row">
        <text class="modal-label">释义</text>
        <text class="modal-val">{{synModal.zh}}</text>
      </view>
      <view class="modal-row">
        <text class="modal-label">英文</text>
        <text class="modal-val modal-val-dim">{{synModal.en}}</text>
      </view>
      <view wx:if="{{synModal.ex}}" class="modal-row">
        <text class="modal-label">场景</text>
        <view class="modal-example">
          <view class="modal-ex-en">{{synModal.ex}}</view>
          <view class="modal-ex-zh">{{synModal.exz}}</view>
        </view>
      </view>
    </view>
    <view wx:else class="modal-not-found">
      此词不在 850 核心词范围内，点上方🔊听发音
    </view>
    <view class="modal-close" bindtap="closeSynModal">关闭</view>
  </view>
</view>
